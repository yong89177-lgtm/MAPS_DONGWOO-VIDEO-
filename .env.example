PORT=3000
# 관리자 승인 페이지에 접근하기 위한 키. 배포 시 반드시 변경하세요.
ADMIN_KEY=change-me-admin-key

# v2 메인 화면(단일 HTML) 로그인 계정. 1차(IT) 승인은 ADMIN_ID 계정만, 2차(적절성) 승인은
# 그 외 관리자 계정만 처리할 수 있으므로 반드시 서로 다른 두 계정을 설정해야 한다.
ADMIN_ID=admin
ADMIN_PASSWORD=change-me-1st-admin-password
ADMIN2_ID=admin2
ADMIN2_PASSWORD=change-me-2nd-admin-password
